# Neon (PostgreSQL serverless)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Cloudflare R2 (stockage fichiers)
CLOUDFLARE_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=folyyo

# Anthropic (generation Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Vercel (deploiement portfolios) — nom préfixé FOLYYO_ car "VERCEL_TOKEN" tout
# court est un nom réservé par la plateforme Vercel elle-même (non éditable
# dans son dashboard, valeur "Populated by System").
FOLYYO_VERCEL_TOKEN=...
# Optionnel — uniquement si le compte Vercel utilise une Team (pas un compte perso)
VERCEL_TEAM_ID=

# YouTube Data API (connexion chaîne YouTube à l'onboarding)
YOUTUBE_API_KEY=

# Optionnel — sans elle, l'API GitHub est appelée sans authentification (quota bien plus bas)
GITHUB_TOKEN=

# Unsplash (photos de fond variées à la génération de portfolio) — optionnel,
# sans elle chaque preset retombe sur son URL statique de repli (comportement
# d'avant). Créer une app sur unsplash.com/developers pour obtenir l'Access Key.
UNSPLASH_ACCESS_KEY=

# Admin — IDs Clerk (user_xxx) autorisés à acceder a /dashboard/admin, separes par des virgules
ADMIN_USER_IDS=

# Stripe (abonnement) — cle secrete + secret de signature webhook (donne par
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` en local),
# plus les 2 price_id crees dans le dashboard Stripe (mensuel/annuel)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# Resend — e-mails de notification à l'exploitant (nouvel abonné, nouveau
# message de support) ET séquence d'essai envoyée aux clients (J0 à la
# génération, relance J1-J2, urgence J3 — voir lib/email/notify.ts).
# OPTIONNEL : sans RESEND_API_KEY, tout est simplement ignoré (journalisé),
# rien ne casse. Créer une clé sur resend.com. Tant que le domaine folyo.page
# n'est pas vérifié dans Resend, laisser EMAIL_FROM vide (défaut =
# onboarding@resend.dev, qui n'envoie QUE vers l'e-mail du compte Resend —
# donc AUCUN e-mail client ne part réellement tant que folyo.page n'est pas
# vérifié) ; une fois vérifié, mettre EMAIL_FROM="Folyo <notifications@folyo.page>".
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=novaflows.pro@gmail.com
EMAIL_FROM=

# Cron (app/api/cron/trial-emails, planifié par vercel.json) — protège la
# route contre un appel public : Vercel Cron envoie automatiquement
# "Authorization: Bearer $CRON_SECRET" à l'exécution planifiée. Générer une
# valeur aléatoire (ex. `openssl rand -hex 24`) et la mettre aussi sur Vercel.
CRON_SECRET=

# URL publique de CETTE app (pas des sites générés) — utilisée au moment de la
# génération pour construire l'URL du beacon de vues (app/api/track) injecté
# dans chaque portfolio déployé. Repli sur l'alias Vercel stable si absente.
NEXT_PUBLIC_APP_URL=https://folyyo.vercel.app
